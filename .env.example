# ─────────────────────────────────────────────────────────────────────────────
# RISE — Environment Variables Example
# Duplicate this file as .env and fill in your credentials
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API Key (Gemini 2.5 Flash / 1.5 Pro)
# Get your API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud OAuth 2.0 Client ID (Web Application)
# Required for Google Identity Services (GIS) & Google Drive Auto-Sync
# Configure at Google Cloud Console: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
